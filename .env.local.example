# Google OAuth の認証情報。
#
# このファイルを .env.local にコピーし、Google Cloud Console で作成した
# OAuth 2.0 クライアント ID の値を入れる。.env.local はコミットしない。
#
#   cp .env.local.example .env.local
#
# 取得手順は README.md の「Google OAuth のセットアップ」を参照。

GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
